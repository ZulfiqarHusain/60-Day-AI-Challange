        "# 5 Test Queries based on custom data\n",
        "test_queries = [\n",
        "    \"Who developed the UrbanEye project and what does it do?\",\n",
        "    \"When did Zulfiqar organize the prompt engineering workshop?\",\n",
        "    \"What is the NBA aligned exam paper formatter used for?\",\n",
        "    \"Where is Zulfiqar Husain pursuing his B.Tech specialization?\",\n",
        "    \"What is the exact salary package of a Relationship Manager at IDFC FIRST Bharat?\"\n",
        "]\n",
        "\n",
        "print(f\"{'Query':<55} | {'Without RAG (Direct LLM)':<35} | {'With RAG (Grounded)'}\")\n",
        "print(\"=\"*140)\n",
        "\n",
        "for q in test_queries:\n",
        "    ans_without = generate_without_rag(q)\n",
        "    ans_with, _ = generate_with_rag(q)\n",
        "    print(f\"{q[:53]:<55} | {ans_without[:33]:<35} | {ans_with}\")"
